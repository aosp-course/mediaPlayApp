<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base da aplicação para o Modo Escuro -->
    <style name="Theme.MediaPlayerApp" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Mapeamento das suas cores para atributos semânticos de tema -->
        <item name="colorPrimary">@color/progressColor</item>
        <item name="colorPrimaryVariant">@color/progressColor</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryVariant">@color/gold</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <item name="android:colorBackground">@color/backgroundPrimary</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>

        <item name="colorSurface">@color/backgroundSecondary</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>

        <!-- Cores de texto padrão -->
        <item name="android:textColorPrimary">@color/colorOnBackground</item>
        <item name="android:textColorSecondary">@color/colorOnSurface</item>

        <!-- Cor da barra de status (Android 5.0+) -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/android:colorBackground</item>
        <!-- Cor dos ícones da barra de status para dark theme (ícones claros) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Atributo customizado para a cor do fundo da SeekBar -->
        <item name="colorSeekBarTrack">@color/seekBarBackground</item>
    </style>
</resources>
